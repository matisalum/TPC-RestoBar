<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.master.cs" Inherits="TPCRestoBar.Master" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>RestoBar3</title>

    <asp:ContentPlaceHolder ID="head" runat="server" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</head>
<body class="d-flex flex-column min-vh-100">

    <form id="form1" runat="server" class="d-flex flex-column flex-grow-1">

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
            <div class="container">

                <a class="navbar-brand fw-bold" href="Default.aspx">🍽 RestoBar3
                </a>

                <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link" href="Default.aspx">Inicio</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Mesas.aspx">Mesas</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Empleados.aspx">Empleados</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Carta.aspx">Carta</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Producto.aspx">Productos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Pedidos.aspx">Pedidos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Login.aspx">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Registro.aspx">Registrarse</a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>

        <main class="container mt-4 flex-grow-1">
            <div class="card shadow">
                <div class="card-body">

                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>

                </div>
            </div>
        </main>

        <footer class="bg-dark text-white text-center p-3 mt-4">
            TP Programación III - RestoBar3 © 2026
        </footer>

    </form>

</body>
</html>
